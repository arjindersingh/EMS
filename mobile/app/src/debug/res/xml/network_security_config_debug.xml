<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: allows plain HTTP so the app can be tested against a
    local WAMP server on the LAN (e.g. http://192.168.x.x/ems). Release builds
    have no such override and require HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
